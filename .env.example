# RevenueCat public SDK keys.
#
# These are the PUBLIC keys from app.revenuecat.com -> Project -> API keys.
# They are designed to ship inside the client. Never put a *secret* key here.
#
# Leave a value empty and the app runs in "preview" mode: the whole purchase
# flow is still walkable, but nothing is charged and no store is contacted.

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Web purchases bill through RevenueCat Billing (Stripe) and use their own key,
# separate from the iOS/Android in-app purchase keys. Required for the web build.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# The entitlement identifier that unlocks Collos Pro. Must match the dashboard —
# the Collos project uses `collos_pro`, which is also the value the app falls
# back to when this variable is missing.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=collos_pro

# Project ID from the dashboard URL: app.revenuecat.com/projects/<prj_...>
# Shipaton asks for this on the submission form; the app shows it in Settings so
# it is easy to copy across.
EXPO_PUBLIC_REVENUECAT_PROJECT_ID=
