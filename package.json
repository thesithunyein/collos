{
  "name": "collos",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/careStore.test.mjs tests/smoke.test.mjs",
    "docs:check": "node scripts/check-readme.mjs",
    "screenshots": "node scripts/capture-app-screenshots.mjs",
    "screenshots:devpost": "node scripts/capture-app-screenshots.mjs --set devpost",
    "screenshots:appstore": "node scripts/capture-app-screenshots.mjs --set appstore",
    "screenshots:playstore": "node scripts/capture-app-screenshots.mjs --set playstore",
    "release:init": "npx --yes eas-cli@24.8.0 init",
    "release:preview": "npx --yes eas-cli@24.8.0 build --profile preview",
    "release:ios": "npx --yes eas-cli@24.8.0 build --platform ios --profile production",
    "release:android": "npx --yes eas-cli@24.8.0 build --platform android --profile production",
    "submit:ios": "npx --yes eas-cli@24.8.0 submit --platform ios --profile production",
    "submit:android": "npx --yes eas-cli@24.8.0 submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.26",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "10.10.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-font": "~57.0.4"
  }
}
